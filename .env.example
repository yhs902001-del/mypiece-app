# ─────────────────────────────────────────────
# MyPiece 환경변수 예시 파일
# 실제 값은 Firebase Console → Project Settings 및 Service Account에서 가져오세요.
# 이 파일을 복사해서 `.env.local` 로 이름을 바꾼 뒤 값을 채워 넣으면 됩니다.
# 절대 실제 값이 담긴 파일(.env.local)은 깃에 커밋하지 마세요.
# ─────────────────────────────────────────────

# ── 클라이언트용 (브라우저에 노출됨, NEXT_PUBLIC_ 프리픽스 필수) ──
# Firebase Console → Project Settings → General → Your apps (Web app) 에서 복사
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

# FCM 푸시 알림용 Web Push certificate key
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates 에서 생성/복사
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── 서버 전용 (API route에서만 사용, 절대 클라이언트 노출 금지) ──
# Firebase Console → Project Settings → Service accounts → Generate new private key
# 다운로드된 JSON 의 project_id, client_email, private_key 를 사용
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# private_key는 여러 줄이므로 \n을 문자 그대로 포함한 채 큰따옴표로 감싸세요
# 예: FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ── AI 이미지 검열 (Google Cloud Vision SafeSearch) ──
# 미설정 시 /api/moderate-image는 mock 폴백(랜덤 85% 통과)으로 동작
# 실 검열을 켜려면:
#  1) GCP Console → APIs & Services → Library → "Cloud Vision API" Enable
#  2) Credentials → Create Credentials → API Key → 발급된 값을 아래에 넣기
#  3) (권장) API Key 제한 설정: 사용 가능 API를 Cloud Vision API로만 제한
# SafeSearch 기준: adult LIKELY+ · racy VERY_LIKELY · violence LIKELY+ · 얼굴 감지 시 reject
VISION_API_KEY=
